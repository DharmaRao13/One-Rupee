# Copy to .env and fill with your Supabase project values
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_key

# Razorpay LIVE keys are NOT stored in the frontend.
# Set these in Supabase Dashboard → Project Settings → Edge Functions → Secrets:
#
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=your_live_secret
# RAZORPAY_ALLOW_LIVE=true
# RAZORPAY_MODE=live
#
# Test keys (rzp_test_*) work without RAZORPAY_ALLOW_LIVE.

# Optional: show live-payment badge on Pay page before checkout
# VITE_RAZORPAY_MODE=live
